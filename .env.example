# Optional. Everything here can also be pasted into the "Add keys" dialog at
# http://localhost:4310 — this file is only for people who prefer env vars.
# Copy to .env.local and load it however you like; the app reads process.env.

# Makes the phone calls. dashboard.vapi.ai -> API Keys
VAPI_API_KEY=
# Which of your Vapi numbers to call from. Leave blank to use the first one.
VAPI_PHONE_NUMBER_ID=
# The Public Key on that same Vapi page. Lets you hear the call in the browser.
VAPI_PUBLIC_KEY=

# Optional. Adds Facebook Marketplace to every search.
# app.scrapecreators.com — 100 free credits, no card.
SCRAPECREATORS_API_KEY=

# Port for the dashboard (default 4310).
PORT=
